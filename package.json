{
  "name": "album-template-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app for album order template generation and editable layout management.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check:image-layer-persistence": "node --experimental-strip-types scripts/check-image-layer-persistence.mjs",
    "check:inspector-layout": "node scripts/check-inspector-layout.mjs",
    "check:product-safe-distance": "node --experimental-strip-types scripts/check-product-safe-distance-normalization.mjs",
    "check:editor-asset-default-size": "node scripts/check-editor-asset-default-size.mjs",
    "check:editor-style-scope": "node scripts/check-editor-style-scope.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@monaco-editor/react": "^4.7.0",
    "animejs": "^3.2.2",
    "antd": "^6.5.4",
    "axios": "^1.19.0",
    "color": "^3.1.3",
    "echarts": "^4.9.0",
    "fabric": "^7.4.0",
    "gifler": "^0.1.0",
    "honeycomb-grid": "^3.1.7",
    "i18next": "^19.9.2",
    "i18next-browser-languagedetector": "^2.2.4",
    "jspdf": "^2.5.2",
    "lodash-es": "^4.17.23",
    "mediaelement": "^4.2.17",
    "monaco-editor": "^0.56.0",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "resize-observer-polyfill": "^1.5.1",
    "svg-path-properties": "^1.3.0",
    "text-to-svg": "^3.1.5",
    "uuid": "^11.1.0",
    "warning": "^4.0.3"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.13",
    "@types/color": "^3.0.6",
    "@types/echarts": "^4.9.22",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/text-to-svg": "^3.1.4",
    "@types/uuid": "^7.0.2",
    "@types/warning": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.5.26",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "core-js@3.50.0": true,
    "esbuild@0.21.5": true
  }
}
